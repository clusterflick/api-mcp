{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clusterflick-api-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Outbound fetches go over the public internet, never same-zone routing:
  // the OAuth library needs it to fetch a client's metadata document safely,
  // and the listings come from clusterflick.com either way.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Its own host, so the OAuth addresses (`/.well-known/…`) are clear of the
  // site's. Cloudflare makes the DNS record and certificate on deploy.
  "routes": [{ "pattern": "mcp.clusterflick.com", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    // Where the listings are read from (`data/current.json`), and what
    // results link to.
    "SITE_ORIGIN": "https://clusterflick.com",
    // This Worker, as assistants reach it: the OAuth resource and issuer.
    "MCP_ORIGIN": "https://mcp.clusterflick.com",
    // The site's page that signs a reader in for their assistant.
    "CONNECT_URL": "https://clusterflick.com/connect/",
    // Public: it's in the site's Firebase web config too.
    "FIREBASE_PROJECT_ID": "clusterflick-com",
  },
  // This Worker's own service account, with Cloud Datastore Viewer, to read
  // a reader's capabilities. Set with `wrangler secret put`, locally in
  // `.dev.vars`.
  "secrets": { "required": ["FIREBASE_SERVICE_ACCOUNT"] },
  // The OAuth library's store: clients, grants and tokens (tokens only as
  // hashes, a grant's props encrypted). `wrangler dev` and the tests keep
  // their own local copy.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "88c270f40b6246d7956c77b5e167891b" },
  ],
  // Per-location and approximate, as in the other Workers: it deters abuse
  // rather than enforcing a quota. api-tmdb-search has 1xxx, api-profiles 2xxx.
  "ratelimits": [
    {
      "name": "CALL_LIMIT",
      "namespace_id": "3001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // The OAuth store's sweep for what KV's own expiry leaves (src/index.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  // api-tmdb-search has 8787 and api-profiles 8788. `host` keeps requests
  // addressed to localhost: otherwise `wrangler dev` rewrites them to the
  // custom domain above, and the OAuth addresses it builds from them stop
  // matching `MCP_ORIGIN`.
  "dev": { "port": 8789, "host": "localhost:8789" },
  // Workers Paid has no spend cap, so a ceiling per request. An isolate's
  // first call reads the listings: parsing 13MB, restoring them and building
  // the vocabulary took ~120ms in Node on an M-series Mac, a search after
  // that under 10ms. A preview (`wrangler dev --remote`) doesn't apply this
  // limit, so it can't measure it. Headroom, not a fit: lower it once Workers
  // Logs show what a first call really costs.
  "limits": { "cpu_ms": 1000 },
  "observability": { "enabled": true },
}
